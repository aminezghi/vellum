# --- Vellum build outputs and distributions ---
# Next.js build output
.next/
out/
# TypeScript incremental build cache
*.tsbuildinfo
# PyInstaller workdir and output, Inno Setup output
build/
dist/
# Distribution archives (standalone zip, Bento zip, Fernly export zip)
*.zip
# The compiled Windows installer. It is a 129 MB build artefact, regenerated
# by tools/build_distributables.py + ISCC (see BUILDING.md). Shipping it
# through git would add its full weight to every clone and every future
# commit, for a file that is rebuilt from source anyway. It stays on disk so
# it can be sent to colleagues directly.
Vellum_Desktop/Vellum-Desktop-V2.1-Setup-x64.exe
# The generated one-click web package (bundles a portable Node.js runtime).
Vellum_Web/Vellum_Web_Fernly_SHARE/
# Open Science Desktop session marker
.openscience/

# --- Bulk binary media (images / audio / video) ---
# These arrive in the thousands (a copied image or audio dataset) and each file
# is usually well under the 20 MB per-file size guard, so that guard can't stop
# them — thousands of small binaries would bloat history fatally, and git can
# neither delta nor compress them. They are also almost always either raw data
# or a regenerable render, not source. Text/vector figures (.svg) and documents
# (.pdf) are kept — they are small, versionable, and usually authored output.
# Notebook plots are embedded in the versioned .ipynb already. Delete a line
# below if that medium is your primary data and you want it in snapshots.
# Video
*.mp4
*.m4v
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.flv
*.mpg
*.mpeg
*.ogv
*.3gp
# Images (raster)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tif
*.tiff
*.webp
*.heic
*.heif
*.ico
*.psd
*.raw
*.cr2
*.nef
*.arw
*.dng
# Audio
*.wav
*.flac
*.aac
*.m4a
*.mp3
*.ogg
*.oga
*.wma
*.aiff
*.aif

# --- Vellum brand assets: MUST stay tracked ---
# The bulk-media rule above is aimed at datasets and renders, but these few
# files are *build inputs* and *product identity*:
#   downloader.ico  -> build_vellum_windows.spec (icon=) and installer.iss
#                      (SetupIconFile=). Without it a fresh clone cannot
#                      produce the installer at all.
#   downloader.png  -> runtime PhotoImage fallback (vellum_packaging.ICONS).
#   assets/         -> shipped into the frozen bundle (vellum_packaging.TREES)
#                      and used by the in-app documentation pages.
#   favicon.ico     -> the web app's browser tab icon.
# Losing any of them makes the repository non-reproducible.
!Vellum_Desktop/Desktop_App/downloader.ico
!Vellum_Desktop/Desktop_App/downloader.png
!Vellum_Desktop/Desktop_App/assets/
!Vellum_Desktop/Desktop_App/assets/**
!Vellum_Desktop/Vellum_Desktop_V2.1_Botanical_Bento/Desktop_App/downloader.ico
!Vellum_Desktop/Vellum_Desktop_V2.1_Botanical_Bento/Desktop_App/downloader.png
!Vellum_Desktop/Vellum_Desktop_V2.1_Botanical_Bento/Desktop_App/assets/
!Vellum_Desktop/Vellum_Desktop_V2.1_Botanical_Bento/Desktop_App/assets/**
!Vellum_Web/Web_App_Fernly/downloader.ico
!Vellum_Web/Web_App_Fernly/downloader.png
!Vellum_Web/Web_App_Fernly/src/app/favicon.ico
!Vellum_Web/Web_App_Fernly/public/favicon.ico
!Vellum_Web/Web_App_Fernly/public/apple-touch-icon.png
!Vellum_Web/Web_App_Fernly/public/vellum-logo.svg
!Vellum_Web/Web_App_Fernly/public/logo-mark.svg
!Vellum_Desktop/Desktop_App/vellum-symbol.svg
!brand-assets/**
!brag-output/vellum-promo-horizontal.jpg
!brag-output/vellum-promo-vertical.jpg

# Development & local scratch tools
.agents/
logo-design-skill-repo/
DISTRIBUTABLES/Vellum_Desktop_Installer_Windows_x64/
DISTRIBUTABLES/Vellum_Desktop_macOS/
DISTRIBUTABLES/Vellum_Web_macOS/
README_MACOS_INSTRUCTIONS.pdf
brag-output/**/node_modules/
brag-output/**/*.mp4
brag-output/*.mp4
